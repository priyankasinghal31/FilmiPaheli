<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_iconbtn"
                android:contentDescription="@string/back"
                android:padding="9dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="serif"
                android:text="@string/settings"
                android:textColor="@color/accent"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- language -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="serif"
            android:text="@string/settings_language"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/langGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:orientation="vertical"
            android:padding="6dp">

            <RadioButton
                android:id="@+id/langEn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/rani"
                android:text="@string/lang_en"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/langHi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/rani"
                android:text="@string/lang_hi"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_note"
            android:textColor="@color/dim"
            android:textSize="12.5sp" />

        <!-- theme -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="serif"
            android:text="@string/settings_theme"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:orientation="vertical"
            android:padding="6dp">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/rani"
                android:text="@string/theme_system"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/rani"
                android:text="@string/theme_light"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/rani"
                android:text="@string/theme_dark"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </RadioGroup>

        <!-- sound and alerts -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="serif"
            android:text="@string/settings_alerts"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:orientation="vertical"
            android:padding="6dp">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSound"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/setting_sound"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVibration"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/setting_vibration"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchReminder"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/setting_reminder"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
