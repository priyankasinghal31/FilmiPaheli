<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: what Google backs up. Progress, coins and settings are in the "filmi" preferences. -->
<full-backup-content>
    <include domain="sharedpref" path="filmi.xml" />
    <exclude domain="file" path="puzzles_remote.json" />
    <exclude domain="database" path="." />
    <exclude domain="cache" path="." />
</full-backup-content>
