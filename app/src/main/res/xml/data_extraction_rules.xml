<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rules for cloud backup and for phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="filmi.xml" />
        <exclude domain="file" path="puzzles_remote.json" />
        <exclude domain="database" path="." />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="filmi.xml" />
        <exclude domain="file" path="puzzles_remote.json" />
        <exclude domain="database" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
